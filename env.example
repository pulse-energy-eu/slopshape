# Copy to .env (gitignored) and fill in your own keys.
# Names only here - never commit values. Keys are only needed for the LLM
# stages (generation, screening, scoring); the analysis stages (r6_*, r7
# evaluation) run without any key.

# StoryScope stages 2-4 + GPT mirrors
OPENAI_API_KEY=

# Claude mirrors
ANTHROPIC_API_KEY=

# Brief extraction, Gemini mirrors, stage 5 feature application
GEMINI_API_KEY=
# Optional rotation keys (rate limits on stage 5's ~105k calls)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# DeepSeek + Kimi mirrors via an OpenAI-compatible AI gateway
# base_url: https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=

# Optional: frame assembly web search (Wayback needs no key)
FIRECRAWL_API_KEY=
